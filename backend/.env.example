# Supabase Configuration
# Wklej swoje dane z Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Groq API Configuration (do RAG Chatbota i dopasowywania innowacji)
# Pobierz darmowy klucz na: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_DIMENSION=2880

# Pollinations (wizualizacje pomysłów w kreatorze, POST /api/idea-creator/generate_image)
# nanobanana2 jest płatny - klucz sekretny (sk_...) z: https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=sk_your_pollinations_key_here
POLLINATIONS_IMAGE_MODEL=gpt-image-2

# RAG & Matching Thresholds
SIMILARITY_THRESHOLD=0.35
CLOSE_MATCH_DELTA=0.05

# JWT & Security
JWT_SECRET=super-secret-key-change-me-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server config
PORT=8000
HOST=0.0.0.0
