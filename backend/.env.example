# Supabase Configuration
# Wklej swoje dane z Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Groq API Configuration (do RAG Chatbota i dopasowywania innowacji)
# Pobierz darmowy klucz na: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_DIMENSION=2880

# RAG & Matching Thresholds
SIMILARITY_THRESHOLD=0.35
CLOSE_MATCH_DELTA=0.05

# JWT & Security
JWT_SECRET=super-secret-key-change-me-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server config
PORT=8000
HOST=0.0.0.0
